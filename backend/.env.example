# Copy to .env for local development. Never commit the real .env.

SECRET_KEY=dev-only-insecure-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Local dev uses SQLite when this is unset. On Render, set it to the
# Postgres "Internal Database URL" -- the free tier has an ephemeral
# filesystem, so SQLite would be wiped on every redeploy.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Must include the GitHub Pages origin once deployed, e.g.
# https://<your-username>.github.io
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BASE_CURRENCY=INR
